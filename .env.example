# Supabase (Settings → API in the Supabase dashboard)
# The anon key is public-by-design: it ships in the JS bundle and is protected by Row Level Security.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Canonical site URL (no trailing slash). Change here when moving to a custom domain.
VITE_SITE_URL=https://ia-cross.github.io/clinic_ui_exposed

# GoatCounter site code (the <code> in https://<code>.goatcounter.com)
VITE_GOATCOUNTER_CODE=verboonen
